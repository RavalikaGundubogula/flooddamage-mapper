# Application Configuration
PROJECT_NAME="Mapping Flood Damage from Space"
VERSION="0.8.0"
ENV="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000

# Satellite Catalog Configuration (Copernicus Data Space Ecosystem)
COPERNICUS_CATALOG_URL="https://catalogue.dataspace.copernicus.eu/odata/v1/Products"
COPERNICUS_DOWNLOAD_URL="https://download.dataspace.copernicus.eu/odata/v1/Products"
COPERNICUS_AUTH_URL="https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token"
CATALOG_TIMEOUT_SECONDS=20
CACHE_ENABLED=true

# Copernicus CDSE OAuth Credentials (required for Sentinel-1/Sentinel-2 binary product downloads)
# Register at: https://dataspace.copernicus.eu/ (OAuth Client Credentials flow)
COPERNICUS_CLIENT_ID="your_cdse_client_id_here"
COPERNICUS_CLIENT_SECRET="your_cdse_client_secret_here"

# OpenStreetMap Overpass API
OVERPASS_URL="https://overpass-api.de/api/interpreter"
OVERPASS_TIMEOUT_SECONDS=25

# Optional LLM API Keys (for multilingual situation report synthesis; falls back cleanly to deterministic rules when omitted)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Data Directories (relative to backend/)
DATA_RAW_DIR="data/raw"
DATA_PROCESSED_DIR="data/processed"
DATA_OUTPUTS_DIR="data/outputs"
DATA_CACHE_DIR="data/cache"
KUROSIWO_DATA_DIR="data/datasets/kuro_siwo"
MODEL_ARTIFACTS_DIR="data/models"
